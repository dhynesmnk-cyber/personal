---
import Base from '../layouts/Base.astro';
import HomeHero from '../components/HomeHero.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceCards from '../components/ServiceCards.astro';
import CtaBand from '../components/CtaBand.astro';
import Arrow from '../components/Arrow.astro';
import { home } from '../content/home';
import { services } from '../content/services';
import { workHref } from '../content/work';

const { results, record } = home;
---

<Base>
  <HomeHero />

  <section class="section home-services" aria-labelledby="services-title">
    <div class="container">
      <div class="row-head">
        <SectionHead eyebrow={services.stripEyebrow} heading={services.stripHeading} id="services-title" />
        <a class="text-link" href="/services/">{services.stripLink}<Arrow /></a>
      </div>
      <ServiceCards />
    </div>
  </section>

  <section class="section section--alt" id="results" aria-labelledby="results-title">
    <div class="container">
      <div class="row-head">
        <SectionHead eyebrow={results.eyebrow} heading={results.heading} id="results-title" />
        <a class="text-link" href="/work/">{results.link}<Arrow /></a>
      </div>
      <ul class="results" role="list">
        {
          results.items.map((r, i) => (
            <li class="result-card" data-fade style={`--d:${i}`}>
              <p class="result-card__stat" data-count>{r.stat}</p>
              <p class="result-card__label">{r.label}</p>
              <h3 class="result-card__client">
                <a href={workHref(r.slug)}>{r.client}</a>
              </h3>
              <span class="result-card__more" aria-hidden="true">
                <Arrow />
              </span>
            </li>
          ))
        }
      </ul>

      <div class="record" data-fade>
        <p class="record__label">{record.label}</p>
        <ul class="record__list" role="list">
          {record.items.map((item) => <li>{item}</li>)}
        </ul>
        <a class="text-link" href={record.link.href}>{record.link.label}<Arrow /></a>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Services sit straight under the hero, so they start near the fold. */
  .home-services {
    padding-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .row-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .row-head :global(.section-head) {
    margin-bottom: 0;
  }

  /* ----- results ----- */

  .results {
    display: grid;
    gap: var(--space-5);
    margin: 0;
  }

  @media (min-width: 52rem) {
    .results {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .result-card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: var(--space-3);
    padding: clamp(1.4rem, 1rem + 1.4vw, 2rem);
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    background: var(--white);
    transition:
      border-color 0.3s ease,
      box-shadow 0.4s var(--ease-out),
      transform 0.4s var(--ease-out);
  }

  .result-card:hover,
  .result-card:focus-within {
    border-color: var(--rule-strong);
    box-shadow: var(--shadow-frame);
    transform: translateY(-3px);
  }

  .result-card__stat {
    font-family: var(--font-serif);
    font-size: var(--step-stat);
    font-weight: 360;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--forest-900);
  }

  .result-card__label {
    max-width: 18rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .result-card__client {
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .result-card__client a {
    color: var(--olive-700);
    text-decoration: none;
  }

  /* The client link covers the whole card. */
  .result-card__client a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-l);
  }

  .result-card__more {
    position: absolute;
    right: clamp(1.4rem, 1rem + 1.4vw, 2rem);
    bottom: clamp(1.4rem, 1rem + 1.4vw, 2rem);
    color: var(--forest-900);
    transition: transform var(--dur-med) var(--ease-out);
  }

  .result-card:hover .result-card__more {
    transform: translateX(4px);
  }

  /* ----- also on the record ----- */

  .record {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-6);
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule-strong);
  }

  .record__label {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--olive-700);
  }

  .record__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    margin: 0;
    flex: 1 1 28rem;
  }

  .record__list li {
    position: relative;
    padding-left: 1rem;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .record__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--olive-600);
  }
</style>
