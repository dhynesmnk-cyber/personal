---
import Base from '../layouts/Base.astro';
import HomeHero from '../components/HomeHero.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceCards from '../components/ServiceCards.astro';
import Approach from '../components/Approach.astro';
import WorkCard from '../components/WorkCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Arrow from '../components/Arrow.astro';
import { home } from '../content/home';
import { services } from '../content/services';
import { workItems } from '../content/work';

const clientWork = workItems.filter((w) => w.kind === 'client');
---

<Base>
  <HomeHero />

  <section class="section home-services" aria-labelledby="services-title">
    <div class="container">
      <div class="row-head">
        <SectionHead eyebrow={services.stripEyebrow} heading={services.stripHeading} id="services-title" />
        <a class="text-link" href="/services/">{services.stripLink}<Arrow /></a>
      </div>
      <ServiceCards />
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="approach-title">
    <div class="container">
      <Approach />
    </div>
  </section>

  <section class="section" aria-labelledby="home-work-title">
    <div class="container">
      <div class="row-head">
        <SectionHead eyebrow={home.work.eyebrow} heading={home.work.heading} id="home-work-title" />
        <a class="text-link" href="/work/">{home.work.link}<Arrow /></a>
      </div>
      <div class="home-work">
        {clientWork.map((item) => <WorkCard item={item} />)}
      </div>
      <div class="proof">
        <p class="proof__label">{home.proof.label}</p>
        <ul class="proof__list" role="list">
          {home.proof.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="home-transparency-title">
    <div class="container home-split">
      <div class="home-split__copy">
        <SectionHead eyebrow={home.transparency.eyebrow} heading={home.transparency.heading} id="home-transparency-title">
          <p class="lede">{home.transparency.body}</p>
        </SectionHead>
        <a class="text-link" href={home.transparency.link.href}>{home.transparency.link.label}<Arrow /></a>
      </div>
      <ul class="checks" role="list">
        {
          home.transparency.points.map((pt) => (
            <li>
              <span class="checks__gate" aria-hidden="true">
                <span />
                <span />
              </span>
              <h3>{pt.title}</h3>
              <p>{pt.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="home-insights-title">
    <div class="container home-insights">
      <SectionHead eyebrow={home.insights.eyebrow} heading={home.insights.heading} id="home-insights-title">
        <p class="lede">{home.insights.body}</p>
      </SectionHead>
      <a class="text-link" href={home.insights.link.href}>{home.insights.link.label}<Arrow /></a>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Services sit straight under the hero, so they start near the fold. */
  .home-services {
    padding-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    border-top: 1px solid var(--rule);
  }

  .row-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .row-head :global(.section-head) {
    margin-bottom: 0;
  }

  .home-work {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 52rem) {
    .home-work {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ----- proof strip ----- */

  .proof {
    display: grid;
    gap: var(--space-4);
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule);
  }

  .proof__label {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--olive-700);
  }

  .proof__list {
    display: grid;
    gap: var(--space-3) var(--space-6);
    margin: 0;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }

  .proof__list li {
    position: relative;
    padding-left: 1rem;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .proof__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--olive-600);
  }

  /* ----- transparency ----- */

  .home-split {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 5rem);
  }

  .home-split__copy {
    display: grid;
    gap: var(--space-5);
    align-content: start;
    justify-items: start;
  }

  .home-split__copy :global(.section-head) {
    margin-bottom: 0;
  }

  @media (min-width: 64rem) {
    .home-split {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }

  .checks {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }

  .checks li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.25rem 0.75rem;
    padding: 1.25rem;
    border-radius: var(--radius-m);
    background: var(--white);
    border: 1px solid var(--rule);
  }

  .checks__gate {
    grid-row: span 2;
    display: inline-flex;
    gap: 4px;
    padding-top: 0.35rem;
  }

  .checks__gate span {
    width: 3px;
    height: 1.1rem;
    border-radius: 1px;
    background: var(--forest-700);
  }

  .checks h3 {
    font-size: 1.25rem;
  }

  .checks p {
    color: var(--ink-muted);
  }

  /* ----- insights teaser ----- */

  .home-insights {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .home-insights :global(.section-head) {
    margin-bottom: 0;
  }
</style>
