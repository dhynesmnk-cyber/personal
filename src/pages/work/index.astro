---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import WorkCard from '../../components/WorkCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { work, workItems } from '../../content/work';

const clients = workItems.filter((w) => w.kind === 'client');
const builds = workItems.filter((w) => w.kind === 'build');
---

<Base title={work.title} description={work.description}>
  <PageHero eyebrow={work.hero.eyebrow} heading={work.hero.heading} lede={work.hero.lede} />

  <section class="section" aria-labelledby="clients-title">
    <div class="container">
      <h2 class="block-title" id="clients-title">{work.clientHeading}</h2>
      <div class="grid grid--3">
        {clients.map((item) => <WorkCard item={item} />)}
      </div>
    </div>
  </section>

  <section class="section section--alt" id="builds" aria-labelledby="builds-title">
    <div class="container">
      <SectionHead eyebrow={work.buildsEyebrow} heading={work.buildsHeading} id="builds-title">
        <p class="lede">{work.buildsIntro}</p>
      </SectionHead>
      <ul class="checks" role="list">
        {
          work.transparency.map((pt) => (
            <li>
              <span class="checks__gate" aria-hidden="true">
                <span />
                <span />
              </span>
              <h3>{pt.title}</h3>
              <p>{pt.body}</p>
            </li>
          ))
        }
      </ul>
      <div class="grid grid--2">
        {builds.map((item) => <WorkCard item={item} />)}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .block-title {
    margin-bottom: var(--space-6);
    font-size: var(--step-3);
  }

  .grid {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 52rem) {
    .grid--2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .grid--3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ----- transparent by design ----- */

  .checks {
    display: grid;
    gap: var(--space-4);
    margin: 0 0 clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  @media (min-width: 52rem) {
    .checks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .checks li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.25rem 0.75rem;
    align-content: start;
    padding: 1.25rem;
    border-radius: var(--radius-m);
    background: var(--white);
    border: 1px solid var(--rule);
  }

  .checks__gate {
    grid-row: span 2;
    display: inline-flex;
    gap: 4px;
    padding-top: 0.35rem;
  }

  .checks__gate span {
    width: 3px;
    height: 1.1rem;
    border-radius: 1px;
    background: var(--forest-700);
  }

  .checks h3 {
    font-size: 1.2rem;
  }

  .checks p {
    color: var(--ink-muted);
  }
</style>
