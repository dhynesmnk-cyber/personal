---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ClientCase from '../../components/ClientCase.astro';
import BuildDetail from '../../components/BuildDetail.astro';
import CtaBand from '../../components/CtaBand.astro';
import Arrow from '../../components/Arrow.astro';
import WorkPager from '../../components/WorkPager.astro';
import { builds, neighbours, ownPages, tier1, wartsila, work, workItems, type WorkItem } from '../../content/work';

export function getStaticPaths() {
  return workItems
    .filter((item) => !ownPages.has(item.slug))
    .map((item) => ({ params: { slug: item.slug }, props: { item, ...neighbours(item.slug) } }));
}

interface Props {
  item: WorkItem;
  prev: WorkItem;
  next: WorkItem;
}
const { item, prev, next } = Astro.props;
const build = builds.find((b) => b.slug === item.slug);
const note = item.note;
---

<Base title={item.title} description={item.description}>
  <PageHero eyebrow={item.kicker} heading={item.title} lede={item.summary}>
    <a slot="before" class="back-link" href="/work/">
      <Arrow direction="left" />
      {work.back}
    </a>
    {note && <p slot="after" class="hero-note">{note}</p>}
  </PageHero>

  <section class="section" aria-label={item.title}>
    <div class="container">
      {item.slug === tier1.slug && <ClientCase which="tier1" />}
      {item.slug === wartsila.slug && <ClientCase which="wartsila" />}
      {build && <BuildDetail build={build} />}
    </div>
  </section>

  <WorkPager prev={prev} next={next} />

  <CtaBand />
</Base>
