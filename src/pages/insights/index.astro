---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import CtaBand from '../../components/CtaBand.astro';
import Arrow from '../../components/Arrow.astro';
import LayerStack from '../../components/shapes/LayerStack.astro';
import { LINKS } from '../../content/brand';
import { insights } from '../../content/insights';

const { submission, research, matters } = insights;
---

<Base title={insights.title} description={insights.description}>
  <PageHero eyebrow={insights.hero.eyebrow} heading={insights.hero.heading} lede={insights.hero.lede} />

  {
    insights.articles.length > 0 && (
      <section class="section" id="articles" aria-labelledby="articles-title">
        <div class="container">
          <SectionHead eyebrow={insights.articlesEyebrow} heading={insights.articlesHeading} id="articles-title" />
          <ul class="articles" role="list">
            {insights.articles.map((a, i) => (
              <li class="article-card" data-fade style={`--d:${i}`}>
                <p class="article-card__meta">
                  {a.date} <span aria-hidden="true">·</span> {a.readingTime}
                </p>
                <h3 class="article-card__title">
                  <a href={a.href}>{a.title}</a>
                </h3>
                <p class="article-card__summary">{a.summary}</p>
                <p class="article-card__more" aria-hidden="true">
                  {insights.readArticle}
                  <Arrow />
                </p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section section--alt" id="submission" aria-labelledby="submission-title">
    <div class="container split">
      <div class="split__copy">
        <SectionHead eyebrow={submission.eyebrow} heading={submission.heading} id="submission-title" />
        <div class="prose">
          {submission.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <dl class="record" data-fade>
          {
            submission.record.map((r) => (
              <div class="record__row">
                <dt>{r.label}</dt>
                <dd>{r.detail}</dd>
              </div>
            ))
          }
        </dl>
        {
          LINKS.submission && (
            <a class="text-link" href={LINKS.submission}>
              {submission.linkLabel}
              <Arrow direction="up-right" />
            </a>
          )
        }
      </div>
    </div>
  </section>

  <section class="section" id="research" aria-labelledby="research-title">
    <div class="container split split--visual">
      <div class="split__copy">
        <SectionHead eyebrow={research.eyebrow} heading={research.heading} id="research-title" />
        <div class="prose">
          {research.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <p class="muted release">{research.release}</p>
        <p class="links">
          <a class="text-link" href={research.links.project.href}>{research.links.project.label}<Arrow /></a>
          <a class="text-link" href={research.links.repo.href}>{research.links.repo.label}<Arrow direction="up-right" /></a>
        </p>
      </div>
      <div class="split__visual" data-fade>
        <LayerStack layers={4} labels={research.stackLabels} gate accentTop />
        <ul class="stats" role="list">
          {
            research.stats.map((s) => (
              <li>
                <span class="stats__value" data-count>{s.value}</span>
                <span class="stats__label">{s.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="matters-title">
    <div class="container narrow">
      <SectionHead eyebrow={matters.eyebrow} heading={matters.heading} id="matters-title" />
      <div class="prose">
        {matters.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .split {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 5rem);
  }

  .split__copy {
    display: grid;
    gap: var(--space-6);
    align-content: start;
    max-width: 46rem;
  }

  .split__copy :global(.section-head) {
    margin-bottom: 0;
  }

  .prose {
    display: grid;
    gap: var(--space-4);
    font-size: var(--step-1);
    line-height: 1.6;
  }

  .prose p + p {
    color: var(--ink-muted);
  }

  .record {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--rule-strong);
  }

  .record__row {
    display: grid;
    gap: 0.15rem 1.5rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--rule);
  }

  .record dt {
    font-weight: 600;
  }

  .record dd {
    margin: 0;
    color: var(--ink-muted);
  }

  @media (min-width: 40rem) {
    .record__row {
      grid-template-columns: 12rem minmax(0, 1fr);
    }
  }

  .release {
    font-size: 0.9375rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
  }

  .split__visual {
    display: grid;
    gap: var(--space-6);
    align-content: start;
    max-width: 30rem;
    width: 100%;
    justify-self: center;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule-strong);
  }

  .stats li {
    display: grid;
    gap: 0.25rem;
    align-content: start;
  }

  .stats__value {
    font-family: var(--font-serif);
    font-size: var(--step-3);
    line-height: 1;
    color: var(--forest-900);
  }

  .stats__label {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--ink-muted);
  }

  @media (min-width: 64rem) {
    .split--visual {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }

  .narrow {
    max-width: calc(46rem + 2 * var(--gutter));
  }

  .narrow :global(.section-head) {
    margin-bottom: var(--space-6);
  }

  /* ----- articles ----- */

  .articles {
    display: grid;
    gap: var(--space-5);
    margin: 0;
  }

  @media (min-width: 52rem) {
    .articles {
      grid-template-columns: repeat(auto-fill, minmax(26rem, 1fr));
    }
  }

  .article-card {
    position: relative;
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: clamp(1.4rem, 1rem + 1.4vw, 2rem);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--forest-900);
    border-radius: 0 0 var(--radius-l) var(--radius-l);
    background: var(--white);
    transition:
      border-color 0.3s ease,
      box-shadow 0.4s var(--ease-out),
      transform 0.4s var(--ease-out);
  }

  .article-card:hover,
  .article-card:focus-within {
    box-shadow: var(--shadow-frame);
    transform: translateY(-3px);
  }

  .article-card__meta {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--olive-700);
  }

  .article-card__title {
    font-size: var(--step-3);
  }

  .article-card__title a {
    color: var(--ink);
    text-decoration: none;
  }

  .article-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .article-card__summary {
    max-width: 36rem;
    color: var(--ink-muted);
  }

  .article-card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--forest-900);
  }

  .article-card__more :global(.arrow) {
    transition: transform var(--dur-med) var(--ease-out);
  }

  .article-card:hover .article-card__more :global(.arrow) {
    transform: translateX(4px);
  }
</style>
