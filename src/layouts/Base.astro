---
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { CONTACT_EMAIL, LINKS, meta } from '../content/site';

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: meta.name,
  jobTitle: meta.role,
  description: meta.description,
  email: `mailto:${CONTACT_EMAIL}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Melbourne', addressRegion: 'VIC', addressCountry: 'AU' },
  sameAs: [LINKS.github],
  knowsAbout: ['AI strategy', 'AI governance', 'Evaluation design', 'AI adoption', 'Retrieval Augmented Generation'],
  ...(canonical ? { url: canonical } : {}),
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="author" content={meta.name} />
    <meta name="theme-color" content="#f6f5ef" />
    <meta name="color-scheme" content="light" />
    {canonical && <link rel="canonical" href={canonical} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/newsreader-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="David Hynes. I build AI tools that actually work in real business environments." />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
