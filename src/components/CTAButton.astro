---
import { BOOKING_URL, cta } from '../content/brand';
import Arrow from './Arrow.astro';

/**
 * The one primary action on the site. Every instance reads BOOKING_URL, so
 * swapping email for a scheduler is a one-line change in src/content/brand.ts.
 */
interface Props {
  label?: string;
  size?: 'default' | 'small';
  tone?: 'dark' | 'light';
  id?: string;
}
const { label = cta.label, size = 'default', tone = 'dark', id } = Astro.props;
---

<a class:list={['btn', `btn--${tone}`, size === 'small' && 'btn--small']} href={BOOKING_URL} data-cta id={id}>
  <span>{label}</span>
  <Arrow />
</a>

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 3.25rem;
    padding: 0.875rem 1.5rem;
    border-radius: 6px;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.005em;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--dur-fast) ease,
      color var(--dur-fast) ease,
      box-shadow var(--dur-med) var(--ease-out);
  }

  .btn :global(.arrow) {
    transition: transform var(--dur-med) var(--ease-out);
  }

  .btn:hover :global(.arrow) {
    transform: translateX(4px);
  }

  .btn--dark {
    background: var(--forest-900);
    color: var(--paper);
    box-shadow: 0 10px 24px -14px rgb(21 40 29 / 0.7);
  }

  .btn--dark:hover {
    background: var(--forest-700);
    box-shadow: 0 14px 30px -14px rgb(21 40 29 / 0.75);
  }

  .btn--light {
    background: var(--paper);
    color: var(--forest-900);
  }

  .btn--light:hover {
    background: var(--lime-200);
  }

  .btn--small {
    min-height: 2.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.9375rem;
    gap: 0.5rem;
  }
</style>
