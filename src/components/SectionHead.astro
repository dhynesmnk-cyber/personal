---
/** Eyebrow, section heading and optional intro (slot). `num` adds a section number. */
interface Props {
  num?: string;
  eyebrow: string;
  heading: string;
  id: string;
  level?: 'h2' | 'h3';
}
const { num, eyebrow, heading, id, level = 'h2' } = Astro.props;
const Heading = level;
---

<header class="section-head">
  <p class="eyebrow">
    {num && <span class="eyebrow__num">{num}</span>}
    <span class="eyebrow__bar" aria-hidden="true"></span>
    <span>{eyebrow}</span>
  </p>
  <Heading id={id}>{heading}</Heading>
  <slot />
</header>
