---
import { home } from '../content/home';
import CTAButton from './CTAButton.astro';
import Arrow from './Arrow.astro';
import NorthStar from './shapes/NorthStar.astro';

const { hero } = home;
// Set the key phrase in italic without putting markup in the copy file.
const hasEmph = hero.headline.includes(hero.emphasis);
const [before, after] = hasEmph ? hero.headline.split(hero.emphasis) : [hero.headline, ''];
---

<section class="hero on-dark" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">
        <span class="eyebrow__bar" aria-hidden="true"></span>
        <span>{hero.eyebrow}</span>
      </p>
      <h1 id="hero-title">
        {before}{hasEmph && <em>{hero.emphasis}</em>}{after}
      </h1>
      <p class="hero__sub">{hero.sub}</p>
      <div class="hero__actions">
        <CTAButton tone="light" />
        <a class="hero__link" href={hero.secondary.href}>
          {hero.secondary.label}
          <Arrow direction="down" />
        </a>
      </div>
    </div>
  </div>
  <div class="hero__sky">
    <NorthStar labels={hero.sky} id="ns-hero" />
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) 0;
    background:
      radial-gradient(ellipse 55% 65% at 74% 16%, var(--forest-900) 0%, transparent 72%),
      var(--forest-950);
    color: var(--paper);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__grid {
    position: relative;
    z-index: 1;
  }

  .hero__copy {
    display: grid;
    gap: var(--space-5);
    max-width: 40rem;
  }

  .hero .eyebrow {
    color: var(--lime-200);
  }

  h1 {
    max-width: 17ch;
    color: var(--paper);
  }

  h1 em {
    font-style: italic;
    font-weight: 400;
    color: var(--lime-200);
  }

  .hero__sub {
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--sage-200);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-3);
  }

  .hero__link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-weight: 600;
    color: var(--paper);
    text-decoration: underline;
    text-decoration-color: var(--olive-400);
    text-underline-offset: 0.3em;
    transition: text-decoration-color var(--dur-fast) ease;
  }

  .hero__link:hover {
    text-decoration-color: currentColor;
  }

  .hero__sky :global(.ns) {
    height: 100%;
  }

  /* Small screens: the constellation is a full-width band under the copy. */
  .hero__sky {
    width: min(100%, 44rem);
    margin: clamp(1rem, 0.5rem + 2vw, 2rem) auto 0;
    padding-inline: var(--gutter);
    aspect-ratio: 800 / 560;
  }

  /* Wide screens: it fills the right of the hero, fading in behind the copy. */
  @media (min-width: 64rem) {
    .hero {
      min-height: clamp(36rem, 72vh, 46rem);
      align-content: center;
      padding-block: clamp(4rem, 3rem + 3vw, 6rem);
    }

    .hero__sky {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: min(64%, 68rem);
      margin: 0;
      padding: 2rem 2rem 0 0;
      aspect-ratio: auto;
      mask-image: linear-gradient(90deg, transparent 0%, #000 24%);
    }
  }
</style>
