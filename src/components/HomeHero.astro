---
import { brand } from '../content/brand';
import { home } from '../content/home';
import CTAButton from './CTAButton.astro';
import Arrow from './Arrow.astro';
import BridgeField from './shapes/BridgeField.astro';

const { hero } = home;
// Set the key phrase in italic without putting markup in the copy file.
const [before, after] = hero.headline.includes(hero.emphasis)
  ? hero.headline.split(hero.emphasis)
  : [hero.headline, ''];
const hasEmph = hero.headline.includes(hero.emphasis);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">
        <span class="eyebrow__bar" aria-hidden="true"></span>
        <span>{hero.eyebrow}</span>
        <span class="hero__place">{brand.location.split(',')[0]}</span>
      </p>
      <h1 id="hero-title">
        {before}{hasEmph && <em>{hero.emphasis}</em>}{after}
      </h1>
      <p class="lede hero__sub">{hero.sub}</p>
      <div class="hero__actions">
        <CTAButton />
        <a class="text-link" href={hero.secondary.href}>
          {hero.secondary.label}
          <Arrow />
        </a>
      </div>
    </div>
    <div class="hero__visual">
      <BridgeField labels={hero.zones} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) clamp(2.5rem, 2rem + 2vw, 3.5rem);
    isolation: isolate;
  }

  /* A faint drafting grid behind the hero. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(var(--sage-300) 1px, transparent 1.3px);
    background-size: 28px 28px;
    background-position: -14px -14px;
    opacity: 0.5;
    mask-image: linear-gradient(180deg, #000 0%, rgb(0 0 0 / 0.6) 55%, transparent 92%);
  }

  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
    align-items: center;
  }

  .hero__copy {
    display: grid;
    gap: var(--space-5);
  }

  .hero__copy .eyebrow {
    flex-wrap: nowrap;
  }

  @media (max-width: 39.99rem) {
    .hero__place {
      display: none;
    }
  }

  .hero__place {
    color: var(--ink-muted);
  }

  .hero__place::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 4px;
    margin: 0 0.75rem 0.2em 0;
    border-radius: 50%;
    background: currentColor;
    vertical-align: middle;
  }

  h1 {
    max-width: 15ch;
  }

  h1 em {
    font-style: italic;
    font-weight: 400;
    color: var(--forest-700);
  }

  .hero__sub {
    max-width: 36rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-3);
  }

  .hero__visual {
    width: 100%;
    max-width: 38rem;
    justify-self: center;
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .hero__visual {
      max-width: none;
    }
  }

</style>
