---
import { BOOKING_IS_EMAIL, CONTACT_EMAIL, ctaBand } from '../content/brand';
import { home } from '../content/home';
import CTAButton from './CTAButton.astro';
import BridgeField from './shapes/BridgeField.astro';

/** The closing call to action at the foot of every page. */
---

<section class="section on-dark cta-band" aria-labelledby="cta-band-title">
  <div class="container cta-band__grid">
    <div class="cta-band__copy">
      <h2 id="cta-band-title">{ctaBand.heading}</h2>
      <p class="cta-band__body">{ctaBand.body}</p>
      <div class="cta-band__actions">
        <CTAButton tone="light" />
      </div>
      {
        BOOKING_IS_EMAIL && (
          <p class="cta-band__note">
            {ctaBand.emailNote} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
          </p>
        )
      }
    </div>
    <div class="cta-band__visual">
      <BridgeField mode="settled" labels={home.hero.zones} />
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--forest-900);
    color: var(--paper);
    overflow: hidden;
  }

  .cta-band__grid {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
    align-items: center;
  }

  .cta-band__copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .cta-band h2 {
    max-width: 16ch;
    font-size: clamp(2.25rem, 1.4rem + 3.4vw, 4rem);
    line-height: 1.04;
  }

  .cta-band__body {
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--sage-200);
  }

  .cta-band__actions {
    margin-top: var(--space-2);
  }

  .cta-band__note {
    font-size: 0.9375rem;
    color: var(--sage-200);
  }

  .cta-band__note a {
    color: var(--paper);
    text-decoration: underline;
    text-decoration-color: var(--olive-400);
    text-underline-offset: 0.25em;
    overflow-wrap: anywhere;
  }

  .cta-band__note a:hover {
    text-decoration-color: currentColor;
  }

  /* Re-tint the bridge for the dark band. */
  .cta-band__visual {
    --paper: var(--forest-950);
    --paper-3: #2a4636;
    --moss-100: #24402f;
    --rule-strong: #4b6a55;
    --sage-200: #3a5a46;
    --sage-300: #5d7a63;
    --forest-700: var(--lime-200);
    --forest-900: var(--lime-200);
    --ink-muted: var(--sage-200);
    color: #c9d4bd;
  }

  .cta-band__visual :global(.bridge__labels) {
    color: #b8c6aa;
  }

  @media (min-width: 64rem) {
    .cta-band__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
</style>
