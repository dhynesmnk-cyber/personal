---
import { BOOKING_IS_EMAIL, CONTACT_EMAIL, ctaBand } from '../content/brand';
import CTAButton from './CTAButton.astro';
import NorthStar from './shapes/NorthStar.astro';

/** The closing call to action at the foot of every page. */
---

<section class="section on-dark cta-band" aria-labelledby="cta-band-title">
  <div class="container cta-band__grid">
    <div class="cta-band__copy" data-fade>
      <h2 id="cta-band-title">{ctaBand.heading}</h2>
      <p class="cta-band__body">{ctaBand.body}</p>
      <div class="cta-band__actions">
        <CTAButton tone="light" />
      </div>
      {
        BOOKING_IS_EMAIL && (
          <p class="cta-band__note">
            {ctaBand.emailNote} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
          </p>
        )
      }
    </div>
    <div class="cta-band__visual" data-fade style="--d:2">
      <NorthStar mode="settled" id="ns-cta" />
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--forest-900);
    color: var(--paper);
    overflow: hidden;
  }

  .cta-band__grid {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
    align-items: center;
  }

  .cta-band__copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .cta-band h2 {
    max-width: 16ch;
    font-size: clamp(2.25rem, 1.4rem + 3.4vw, 4rem);
    line-height: 1.04;
  }

  .cta-band__body {
    max-width: 34rem;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--sage-200);
  }

  .cta-band__actions {
    margin-top: var(--space-2);
  }

  .cta-band__note {
    font-size: 0.9375rem;
    color: var(--sage-200);
  }

  .cta-band__note a {
    color: var(--paper);
    text-decoration: underline;
    text-decoration-color: var(--olive-400);
    text-underline-offset: 0.25em;
    overflow-wrap: anywhere;
  }

  .cta-band__note a:hover {
    text-decoration-color: currentColor;
  }

  .cta-band__visual {
    width: 100%;
    max-width: 34rem;
    justify-self: center;
  }

  @media (min-width: 64rem) {
    .cta-band__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
</style>
