---
import { CONTACT_EMAIL, LINKS, brand, footer, nav } from '../content/brand';
import Mark from './Mark.astro';
import LogoWall from './LogoWall.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <LogoWall />

  <div class="site-footer__main">
    <div class="container site-footer__grid">
      <div class="site-footer__id">
        <p class="site-footer__name"><Mark size={22} /> {brand.name}</p>
        <p class="muted">{footer.blurb}</p>
        <p class="muted">{brand.location}. {brand.reach}</p>
      </div>

      <nav aria-label="Footer">
        <h2 class="site-footer__title">{footer.pagesTitle}</h2>
        <ul role="list">
          <li><a href="/">Home</a></li>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </nav>

      <div>
        <h2 class="site-footer__title">{footer.contactTitle}</h2>
        <ul role="list">
          <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
          <li><a href={LINKS.github}>GitHub</a></li>
        </ul>
      </div>
    </div>
    <div class="container site-footer__base">
      <p class="muted">&copy; {year} {brand.name}. {footer.rights}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer__main {
    padding-block: var(--space-8) var(--space-6);
    background: var(--paper);
    border-top: 1px solid var(--rule);
    font-size: 0.9375rem;
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  }

  .site-footer__id {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    max-width: 24rem;
  }

  .site-footer__name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-serif);
    font-size: 1.25rem;
  }

  .site-footer__title {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--olive-700);
    margin-bottom: var(--space-3);
  }

  .site-footer li + li {
    margin-top: 0.35rem;
  }

  .site-footer__main a {
    display: inline-block;
    padding-block: 0.15rem;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 0.25em;
    overflow-wrap: anywhere;
  }

  .site-footer__main a:hover {
    text-decoration-color: currentColor;
  }

  .site-footer__base {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule);
    font-size: var(--step--1);
  }
</style>
