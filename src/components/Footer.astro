---
import { CONTACT_EMAIL, LINKS, footer, meta, nav } from '../content/site';
import Mark from './Mark.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__id">
      <p class="site-footer__name"><Mark size={22} /> {meta.name}</p>
      <p class="muted">{meta.role}.<br />{meta.location}.</p>
    </div>

    <nav aria-label="Footer">
      <h2 class="site-footer__title">On this page</h2>
      <ul role="list">
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class="site-footer__title">{footer.credentialsTitle}</h2>
      <ul role="list" class="muted">
        {footer.credentials.map((c) => <li>{c}</li>)}
      </ul>
    </div>

    <div>
      <h2 class="site-footer__title">Contact</h2>
      <ul role="list">
        <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
        <li><a href={LINKS.github}>GitHub</a></li>
      </ul>
    </div>
  </div>
  <div class="container site-footer__base">
    <p class="muted">&copy; {year} {meta.name}. Built as a static site: no trackers, no third-party scripts.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-8) var(--space-6);
    background: var(--paper);
    border-top: 1px solid var(--rule);
    font-size: 0.9375rem;
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  }

  .site-footer__name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    margin-bottom: var(--space-3);
  }

  .site-footer__title {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--olive-700);
    margin-bottom: var(--space-3);
  }

  .site-footer li + li {
    margin-top: 0.35rem;
  }

  .site-footer a {
    display: inline-block;
    padding-block: 0.15rem;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 0.25em;
    overflow-wrap: anywhere;
  }

  .site-footer a:hover {
    text-decoration-color: currentColor;
  }

  .site-footer__base {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule);
    font-size: var(--step--1);
  }
</style>
