---
import { brand, cta, nav } from '../content/brand';
import { menuToggleLabel, menus } from '../content/menus';
import CTAButton from './CTAButton.astro';
import Mark from './Mark.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/' && path.startsWith(href));
const [first, ...rest] = brand.name.split(' ');
---

<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a class="wordmark" href="/" aria-label={`${brand.name}, home`}>
      <Mark />
      <span class="wordmark__text" aria-hidden="true">
        <span class="wordmark__name">{[first, rest[0]].join(' ')}</span>
        <span class="wordmark__sub">{rest.slice(1).join(' ')}</span>
      </span>
    </a>

    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav" hidden data-menu-btn>
      <span class="menu-btn__bars" aria-hidden="true"><span></span><span></span></span>
      {cta.menu}
    </button>

    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul class="site-nav__list" role="list">
        {
          nav.map((item) => {
            const links = menus[item.href];
            const id = `menu-${item.label.toLowerCase()}`;
            return (
              <li class="nav-item" data-nav-item={links ? '' : undefined}>
                <a class="nav-link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
                {links && (
                  <button
                    class="nav-toggle"
                    type="button"
                    aria-expanded="false"
                    aria-controls={id}
                    aria-label={menuToggleLabel(item.label)}
                    hidden
                    data-nav-toggle
                  >
                    <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
                      <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </button>
                )}
                {links && (
                  <div class="nav-panel" id={id}>
                    <ul class="nav-panel__list" role="list">
                      {links.map((l) => (
                        <li>
                          <a class="nav-panel__link" href={l.href}>
                            <span class="nav-panel__label">{l.label}</span>
                            {l.note && <span class="nav-panel__note">{l.note}</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="site-header__cta">
      <CTAButton size="small" label={cta.short} />
    </div>
  </div>
</header>

<script>
  // Without this script the nav wraps onto its own row and every top-level
  // link works; on wide screens the dropdowns still open on hover and focus.
  // With it: a menu button on small screens, and disclosure dropdowns that
  // open on hover (with a short intent delay), on click or with the keyboard.
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const button = header?.querySelector<HTMLButtonElement>('[data-menu-btn]');
  if (header && button) {
    header.dataset.js = '';
    button.hidden = false;
    const wide = window.matchMedia('(min-width: 60rem)');
    const items = Array.from(header.querySelectorAll<HTMLElement>('[data-nav-item]'));

    const toggleOf = (item: HTMLElement) => item.querySelector<HTMLButtonElement>('[data-nav-toggle]')!;
    const setItem = (item: HTMLElement, open: boolean) => {
      item.toggleAttribute('data-open', open);
      toggleOf(item).setAttribute('aria-expanded', String(open));
    };
    const openItem = () => items.find((item) => item.hasAttribute('data-open'));
    const closeAll = (except?: HTMLElement) => items.forEach((item) => item !== except && setItem(item, false));

    const setMenu = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      header.toggleAttribute('data-open', open);
      if (!open) closeAll();
    };
    button.addEventListener('click', () => setMenu(button.getAttribute('aria-expanded') !== 'true'));

    let timer = 0;
    for (const item of items) {
      const toggle = toggleOf(item);
      toggle.hidden = false;
      toggle.addEventListener('click', () => {
        const open = !item.hasAttribute('data-open');
        closeAll(item);
        setItem(item, open);
      });
      toggle.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowDown') return;
        e.preventDefault();
        closeAll(item);
        setItem(item, true);
        item.querySelector<HTMLAnchorElement>('.nav-panel a')?.focus();
      });
      item.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse' || !wide.matches) return;
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          closeAll(item);
          setItem(item, true);
        }, 90);
      });
      item.addEventListener('pointerleave', (e) => {
        if (e.pointerType !== 'mouse' || !wide.matches) return;
        clearTimeout(timer);
        timer = window.setTimeout(() => setItem(item, false), 200);
      });
      item.addEventListener('focusout', (e) => {
        if (wide.matches && !item.contains(e.relatedTarget as Node | null)) setItem(item, false);
      });
    }

    document.addEventListener('click', (e) => {
      if (!header.contains(e.target as Node)) closeAll();
    });

    header.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const item = openItem();
      if (item) {
        setItem(item, false);
        toggleOf(item).focus();
      } else if (header.hasAttribute('data-open')) {
        setMenu(false);
        button.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-5);
    min-height: var(--header-h);
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: calc(var(--header-h) - 1px);
    margin-right: auto;
    color: var(--ink);
    text-decoration: none;
  }

  .wordmark__text {
    display: grid;
    line-height: 1;
  }

  .wordmark__name {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 480;
    letter-spacing: -0.01em;
  }

  .wordmark__sub {
    margin-top: 0.2rem;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--olive-700);
  }

  /* ----- nav ----- */

  .site-nav {
    order: 3;
    flex-basis: 100%;
  }

  .site-nav__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin: 0;
    padding-bottom: 0.5rem;
  }

  .nav-item {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-muted);
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 1px;
    background-repeat: no-repeat;
    background-position: 0 calc(100% - 10px);
    transition:
      color var(--dur-fast) ease,
      background-size var(--dur-med) var(--ease-out);
  }

  .nav-link:hover,
  .nav-link[aria-current='page'],
  .nav-item[data-open] .nav-link {
    color: var(--ink);
    background-size: 100% 1px;
  }

  .nav-link[aria-current='page'] {
    background-image: linear-gradient(var(--olive-600), var(--olive-600));
    background-size: 100% 2px;
  }

  .nav-toggle {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 32px;
    margin-left: 0.15rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-s);
    background: transparent;
    color: var(--ink-muted);
    cursor: pointer;
    transition:
      color var(--dur-fast) ease,
      background-color var(--dur-fast) ease;
  }

  .nav-toggle[hidden] {
    display: none;
  }

  .nav-toggle:hover,
  .nav-item[data-open] .nav-toggle {
    color: var(--ink);
    background: var(--paper-2);
  }

  .nav-toggle svg {
    transition: transform var(--dur-med) var(--ease-out);
  }

  .nav-item[data-open] .nav-toggle svg {
    transform: rotate(180deg);
  }

  /* ----- dropdown panels ----- */

  .nav-panel {
    display: none;
  }

  .nav-panel__list {
    display: grid;
    margin: 0;
  }

  .nav-panel__link {
    display: grid;
    gap: 0.1rem;
    min-height: 44px;
    align-content: center;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-m);
    color: var(--ink);
    text-decoration: none;
    transition: background-color var(--dur-fast) ease;
  }

  .nav-panel__link:hover {
    background: var(--paper-2);
  }

  .nav-panel__label {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .nav-panel__note {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--ink-muted);
  }

  .site-header__cta {
    display: none;
  }

  /* ----- menu button (only shown once the script has run) ----- */

  .menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 0.85rem;
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    background: var(--white);
    color: var(--ink);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
  }

  .menu-btn[hidden] {
    display: none;
  }

  .menu-btn__bars {
    display: grid;
    gap: 4px;
  }

  .menu-btn__bars span {
    display: block;
    width: 16px;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transition: transform var(--dur-fast) ease;
  }

  .site-header[data-open] .menu-btn__bars span:first-child {
    transform: translateY(3px) rotate(45deg);
  }

  .site-header[data-open] .menu-btn__bars span:last-child {
    transform: translateY(-3px) rotate(-45deg);
  }

  /* With the script running, small screens get a collapsible panel. */
  @media (max-width: 59.99rem) {
    .site-header[data-js] .site-nav {
      display: none;
    }

    .site-header[data-js][data-open] .site-nav {
      display: block;
      padding-block: 0.25rem 1rem;
      border-top: 1px solid var(--rule);
    }

    .site-header[data-js][data-open] .site-nav__list {
      flex-direction: column;
    }

    .site-header[data-js] .nav-item[data-open] .nav-panel {
      display: block;
      flex-basis: 100%;
      margin: 0 0 0.5rem;
      padding: 0.25rem;
      border-left: 2px solid var(--sage-300);
      animation: nav-drop var(--dur-med) var(--ease-out) both;
    }

    .site-header[data-js] .site-header__inner {
      gap: 0 var(--space-3);
    }
  }

  /* Where the browser runs scripts, start in the collapsed layout the script
     will set up, so the page does not jump when it arrives. Browsers with
     scripting off keep the open nav above. */
  @media (scripting: enabled) and (max-width: 59.99rem) {
    .site-header:not([data-open]) .site-nav {
      display: none;
    }

    .site-header .site-header__inner {
      gap: 0 var(--space-3);
    }

    .menu-btn[hidden] {
      display: inline-flex;
    }
  }

  /* Likewise the dropdown chevrons hold their space from the first paint. */
  @media (scripting: enabled) {
    .nav-toggle[hidden] {
      display: inline-grid;
    }
  }

  /* On narrow phones the header CTA lives inside the open menu. */
  @media (max-width: 29.99rem) {
    .site-header[data-js][data-open] .site-header__cta {
      display: block;
      order: 4;
      flex-basis: 100%;
      padding-bottom: 1rem;
    }
  }

  @media (min-width: 30rem) {
    .site-header__cta {
      display: block;
      order: 2;
    }

    .menu-btn {
      order: 3;
    }
  }

  @media (min-width: 60rem) {
    .site-header__inner {
      flex-wrap: nowrap;
    }

    .menu-btn {
      display: none !important;
    }

    .site-nav {
      order: 0;
      flex-basis: auto;
    }

    .site-nav__list {
      gap: clamp(0.75rem, 0.25rem + 1vw, 1.75rem);
      padding-bottom: 0;
    }

    .nav-item {
      flex-wrap: nowrap;
    }

    /* The panel hangs below its item. Its top padding bridges the gap, so
       the pointer can travel from the link to the panel without closing it. */
    .nav-panel {
      display: block;
      position: absolute;
      top: 100%;
      left: -0.75rem;
      z-index: 60;
      width: max-content;
      min-width: 17rem;
      max-width: 22rem;
      padding-top: 0.5rem;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-6px);
      transition:
        opacity var(--dur-fast) ease,
        transform var(--dur-med) var(--ease-out),
        visibility 0s linear var(--dur-med);
    }

    .nav-panel__list {
      padding: 0.5rem;
      border: 1px solid var(--rule);
      border-radius: var(--radius-l);
      background: var(--white);
      box-shadow: var(--shadow-frame);
    }

    .nav-item[data-open] .nav-panel,
    .site-header:not([data-js]) .nav-item:hover .nav-panel,
    .site-header:not([data-js]) .nav-item:focus-within .nav-panel {
      visibility: visible;
      opacity: 1;
      transform: none;
      transition-delay: 0s;
    }
  }

  @keyframes nav-drop {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
</style>
