---
import { work, workHref, type WorkItem } from '../content/work';
import Arrow from './Arrow.astro';

/** Previous and next case study, at the foot of every work page. */
interface Props {
  prev: WorkItem;
  next: WorkItem;
}
const { prev, next } = Astro.props;
---

<nav class="container pager" aria-label="More work">
  <a class="pager__link" href={workHref(prev.slug)}>
    <span class="pager__dir"><Arrow direction="left" /> {work.prev}</span>
    <span class="pager__title">{prev.title}</span>
  </a>
  <a class="pager__link pager__link--next" href={workHref(next.slug)}>
    <span class="pager__dir">{work.next} <Arrow /></span>
    <span class="pager__title">{next.title}</span>
  </a>
</nav>

<style>
  .pager {
    display: grid;
    gap: var(--space-4);
    padding-block: 0 var(--section-pad);
  }

  @media (min-width: 48rem) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pager__link {
    display: grid;
    gap: 0.35rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    background: var(--white);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color 0.3s ease,
      box-shadow 0.4s var(--ease-out);
  }

  .pager__link:hover {
    border-color: var(--rule-strong);
    box-shadow: var(--shadow-frame);
  }

  .pager__link--next {
    text-align: right;
    justify-items: end;
  }

  .pager__dir {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--olive-700);
  }

  .pager__title {
    font-family: var(--font-serif);
    font-size: var(--step-1);
  }
</style>
