---
import { LINKS, policy } from '../../content/site';
import SectionHead from '../SectionHead.astro';
import Arrow from '../Arrow.astro';
import LayerStack from '../shapes/LayerStack.astro';
---

<section class="section section--alt" id="policy" aria-labelledby="policy-title">
  <div class="container">
    <SectionHead num="04" eyebrow={policy.eyebrow} heading={policy.heading} id="policy-title" />

    <div class="policy__grid">
      <div class="policy__copy">
        <div class="prose">
          {policy.paragraphs.map((p) => <p>{p}</p>)}
        </div>

        <dl class="record">
          {
            policy.record.map((r) => (
              <div class="record__row">
                <dt>{r.label}</dt>
                <dd>{r.detail}</dd>
              </div>
            ))
          }
        </dl>

        <p class="policy__links">
          {
            LINKS.submission && (
              <a class="text-link" href={LINKS.submission}>
                {policy.links.submission}
                <Arrow direction="up-right" />
              </a>
            )
          }
          <a class="text-link" href={LINKS.observatory}>
            {policy.links.observatory}
            <Arrow direction="up-right" />
          </a>
        </p>
      </div>

      <div class="policy__visual">
        <LayerStack layers={4} labels={policy.stackLabels} gate accentTop />
        <ul class="policy__stats" role="list">
          {
            policy.stats.map((s) => (
              <li>
                <span class="policy__stat-value">{s.value}</span>
                <span class="policy__stat-label">{s.label}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .policy__grid {
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 5rem);
  }

  .policy__copy {
    display: grid;
    gap: var(--space-6);
    align-content: start;
  }

  .policy__copy .prose {
    font-size: var(--step-1);
    line-height: 1.6;
  }

  .policy__copy .prose p + p {
    color: var(--ink-muted);
    font-size: var(--step-0);
  }

  .record {
    display: grid;
    margin: 0;
    border-top: 1px solid var(--rule-strong);
  }

  .record__row {
    display: grid;
    gap: 0.15rem 1.5rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--rule);
  }

  .record dt {
    font-weight: 600;
  }

  .record dd {
    margin: 0;
    color: var(--ink-muted);
  }

  @media (min-width: 40rem) {
    .record__row {
      grid-template-columns: 12rem minmax(0, 1fr);
    }
  }

  .policy__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
  }

  .policy__visual {
    display: grid;
    gap: var(--space-6);
    align-content: start;
    max-width: 30rem;
    width: 100%;
    justify-self: center;
  }

  .policy__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule-strong);
  }

  .policy__stats li {
    display: grid;
    gap: 0.25rem;
    align-content: start;
  }

  .policy__stat-value {
    font-family: var(--font-serif);
    font-size: var(--step-3);
    line-height: 1;
    color: var(--forest-900);
  }

  .policy__stat-label {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--ink-muted);
  }

  @media (min-width: 64rem) {
    .policy__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .policy__visual {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }
</style>
