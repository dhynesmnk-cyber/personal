---
import { hero, meta } from '../../content/site';
import CTAButton from '../CTAButton.astro';
import Arrow from '../Arrow.astro';
import BridgeField from '../shapes/BridgeField.astro';

// Set the key phrase in italic without putting markup in the copy file.
const EMPH = 'actually work';
const [before, after] = hero.headline.includes(EMPH) ? hero.headline.split(EMPH) : [hero.headline, ''];
const hasEmph = hero.headline.includes(EMPH);
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">
        <span class="eyebrow__bar" aria-hidden="true"></span>
        <span>{hero.eyebrow}</span>
        <span class="hero__place">{meta.location.split(',')[0]}</span>
      </p>
      <h1 id="hero-title">
        {before}{hasEmph && <em>{EMPH}</em>}{after}
      </h1>
      <p class="lede hero__sub">{hero.sub}</p>
      <div class="hero__actions">
        <CTAButton />
        <a class="text-link" href={hero.secondary.href}>
          {hero.secondary.label}
          <Arrow direction="down" />
        </a>
      </div>
    </div>
    <div class="hero__visual">
      <BridgeField labels={hero.zones} />
    </div>
  </div>

  <div class="container">
    <div class="proof">
      <p class="proof__label">{hero.proofLabel}</p>
      <ul class="proof__list" role="list">
        {hero.proof.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 2rem + 6vw, 6.5rem) clamp(0.5rem, 0.25rem + 1vw, 1.5rem);
    isolation: isolate;
  }

  /* A faint drafting grid behind the hero. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(var(--sage-300) 1px, transparent 1.3px);
    background-size: 28px 28px;
    background-position: -14px -14px;
    opacity: 0.5;
    mask-image: linear-gradient(180deg, #000 0%, rgb(0 0 0 / 0.6) 55%, transparent 92%);
  }

  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4rem);
    align-items: center;
  }

  .hero__copy {
    display: grid;
    gap: var(--space-5);
  }

  .hero__copy .eyebrow {
    flex-wrap: wrap;
    row-gap: 0.35rem;
  }

  .hero__place {
    color: var(--ink-muted);
  }

  .hero__place::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 4px;
    margin: 0 0.75rem 0.2em 0;
    border-radius: 50%;
    background: currentColor;
    vertical-align: middle;
  }

  h1 {
    max-width: 15ch;
  }

  h1 em {
    font-style: italic;
    font-weight: 400;
    color: var(--forest-700);
  }

  .hero__sub {
    max-width: 36rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-3);
  }

  .hero__visual {
    width: 100%;
    max-width: 38rem;
    justify-self: center;
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .hero__visual {
      max-width: none;
    }
  }

  /* ----- proof strip ----- */

  .proof {
    display: grid;
    gap: var(--space-4);
    margin-top: clamp(3rem, 2rem + 4vw, 5rem);
    padding-top: var(--space-5);
    border-top: 1px solid var(--rule);
  }

  .proof__label {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--olive-700);
  }

  .proof__list {
    display: grid;
    gap: var(--space-3) var(--space-6);
    margin: 0;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }

  .proof__list li {
    position: relative;
    padding-left: 1rem;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--ink);
  }

  .proof__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--olive-600);
  }
</style>
