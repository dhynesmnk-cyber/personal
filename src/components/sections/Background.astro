---
import { background } from '../../content/site';
import SectionHead from '../SectionHead.astro';
import CTAButton from '../CTAButton.astro';
---

<section class="section" id="background" aria-labelledby="background-title">
  <div class="container">
    <SectionHead num="01" eyebrow={background.eyebrow} heading={background.heading} id="background-title" />

    <div class="bg__grid">
      <div class="prose bg__story">
        {background.paragraphs.map((p) => <p>{p}</p>)}
      </div>

      <ul class="bg__lessons" role="list">
        {
          background.lessons.map((l, i) => (
            <li class="bg__lesson">
              <span class="bg__lesson-num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="bg__lesson-title">{l.title}</h3>
              <p>{l.body}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="bg__history">
      <h3 class="bg__history-title">{background.timelineHeading}</h3>
      <ol class="tl" role="list" data-scrub>
        {
          background.timeline.map((t) => (
            <li class:list={['tl__item', t.current && 'tl__item--now']}>
              <p class="tl__when">{t.when}</p>
              <div class="tl__body">
                <h4 class="tl__org">
                  {t.org}
                  {t.current && <span class="tl__now">Current</span>}
                </h4>
                <p class="tl__role">{t.role}</p>
                <p class="tl__text">{t.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="bg__cta">
      <p>{background.ctaLead}</p>
      <CTAButton />
    </div>
  </div>
</section>

<style>
  .bg__grid {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 5rem);
  }

  .bg__story {
    font-size: var(--step-1);
    line-height: 1.6;
  }

  .bg__story p:first-child::first-letter {
    float: left;
    margin: 0.06em 0.12em 0 0;
    font-family: var(--font-serif);
    font-size: 3.6em;
    line-height: 0.8;
    color: var(--forest-900);
  }

  .bg__lessons {
    display: grid;
    gap: 0;
    margin: 0;
    align-self: start;
    border-top: 1px solid var(--rule-strong);
  }

  .bg__lesson {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.25rem 0.75rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }

  .bg__lesson-num {
    grid-row: span 2;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--olive-700);
    padding-top: 0.35rem;
    font-variant-numeric: tabular-nums;
  }

  .bg__lesson-title {
    font-size: 1.3rem;
  }

  .bg__lesson p {
    color: var(--ink-muted);
  }

  @media (min-width: 64rem) {
    .bg__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }

  /* ----- timeline ----- */

  .bg__history {
    display: grid;
    gap: var(--space-6);
    margin-top: clamp(4rem, 3rem + 4vw, 6rem);
  }

  .bg__history-title {
    font-size: var(--step-2);
  }

  .tl {
    --p: 1;
    position: relative;
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0 0 0 1.75rem;
  }

  /* The spine, drawn as the reader scrolls through the story. */
  .tl::before,
  .tl::after {
    content: '';
    position: absolute;
    left: 0.3rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    border-radius: 1px;
  }

  .tl::before {
    background: var(--rule);
  }

  .tl::after {
    background: var(--forest-700);
    transform-origin: top;
    transform: scaleY(var(--p));
  }

  .tl__item {
    position: relative;
    display: grid;
    gap: 0.25rem 2rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--rule);
  }

  .tl__item:last-child {
    border-bottom: 0;
  }

  .tl__item::before {
    content: '';
    position: absolute;
    left: calc(-1.75rem + 0.3rem - 4px);
    top: 1.55rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--paper);
    border: 2px solid var(--forest-700);
    z-index: 1;
  }

  .tl__item--now::before {
    background: var(--forest-900);
    border-color: var(--forest-900);
    box-shadow: 0 0 0 5px var(--moss-100);
  }

  .tl__when {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--olive-700);
    font-variant-numeric: tabular-nums;
  }

  .tl__now {
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: var(--forest-900);
    color: var(--paper);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tl__org {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    font-size: 1.25rem;
  }

  .tl__now {
    font-family: var(--font-sans);
    font-weight: 600;
    line-height: 1.5;
  }

  .tl__role {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink);
  }

  .tl__text {
    margin-top: 0.35rem;
    max-width: 44rem;
    font-size: 0.9375rem;
    color: var(--ink-muted);
  }

  @media (min-width: 48rem) {
    .tl__item {
      grid-template-columns: 11rem minmax(0, 1fr);
    }

    .tl__when {
      align-self: start;
      padding-top: 0.3rem;
    }
  }

  @media (min-width: 64rem) {
    .bg__history {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }

    .bg__history-title {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      align-self: start;
    }
  }

  .bg__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    border-radius: var(--radius-l);
    background: var(--moss-100);
  }

  .bg__cta p {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    line-height: 1.25;
    max-width: 30ch;
  }
</style>
