---
import { clientWork } from '../../content/site';
import SectionHead from '../SectionHead.astro';
import Arrow from '../Arrow.astro';
import ArchitectureDiagram from '../shapes/ArchitectureDiagram.astro';
import ExecBreakdown from '../shapes/ExecBreakdown.astro';
import ReductionBars from '../shapes/ReductionBars.astro';
import GatePipeline from '../shapes/GatePipeline.astro';
import FanIn from '../shapes/FanIn.astro';

const cs = clientWork.caseStudy;
const w = clientWork.wartsila;
const [intel, triage, briefing] = w.blocks;
---

<section class="section section--alt" id="client-work" aria-labelledby="client-work-title">
  <div class="container">
    <SectionHead num="02" eyebrow={clientWork.eyebrow} heading={clientWork.heading} id="client-work-title">
      <p class="lede">{clientWork.intro}</p>
    </SectionHead>

    <!-- Case study: Tier 1 professional services firm -->
    <article class="case" aria-labelledby="case-title">
      <header class="case__head">
        <p class="case__tags">
          <span class="case__tag">{cs.label}</span>
          <span class="case__note">{cs.note}</span>
        </p>
        <h3 id="case-title">{cs.client}</h3>
      </header>

      <div class="case__grid">
        <div class="case__narrative">
          <div class="case__block">
            <h4>{cs.problem.title}</h4>
            <p>{cs.problem.body}</p>
          </div>
          <div class="case__block">
            <h4>{cs.solution.title}</h4>
            <p>{cs.solution.body}</p>
          </div>
        </div>

        <aside class="result" aria-labelledby="case-result">
          <h4 id="case-result" class="result__title">{cs.result.title}</h4>
          <p class="stat">{cs.result.stat}</p>
          <p class="result__label">{cs.result.statLabel}</p>
          <ReductionBars reduction={parseInt(cs.result.stat, 10)} />
          <p class="result__body">{cs.result.body}</p>
        </aside>
      </div>

      <div class="case__diagram">
        <ArchitectureDiagram
          title={cs.diagram.title}
          caption={cs.diagram.caption}
          stages={cs.diagram.stages}
          fallback={cs.diagram.fallback}
          guardrailsTitle={cs.diagram.guardrailsTitle}
          guardrails={cs.diagram.guardrails}
        />
      </div>

      <div class="case__output">
        <div class="case__output-copy">
          <h4>{cs.outputTitle}</h4>
          <p>{cs.outputBody}</p>
        </div>
        <ExecBreakdown title={cs.mockup.title} caption={cs.mockup.caption} sections={cs.mockup.sections} chips={cs.mockup.chips} />
      </div>
    </article>

    <!-- Current engagement: Wärtsilä (USA) -->
    <article class="case case--current" aria-labelledby="wartsila-title">
      <header class="case__head">
        <p class="case__tags">
          <span class="case__tag case__tag--live">{w.label}</span>
          <span class="case__note">{w.role} · {w.when}</span>
        </p>
        <h3 id="wartsila-title">{w.client}</h3>
        <p class="case__intro">{w.intro}</p>
      </header>

      <div class="ws__grid">
        {
          intel && (
            <div class="ws__card ws__card--wide">
              <div class="ws__copy">
                <h4>{intel.title}</h4>
                <p>{intel.body}</p>
              </div>
              {intel.pipeline && (
                <GatePipeline steps={intel.pipeline} label="Market intelligence pipeline, in order" tone="paper" />
              )}
            </div>
          )
        }
        {
          triage && (
            <div class="ws__card ws__card--triage">
              <h4>{triage.title}</h4>
              <div class="ws__stat">
                <p class="stat">{triage.stat}</p>
                <p class="result__label">{triage.statLabel}</p>
              </div>
              <ReductionBars reduction={parseInt(triage.stat ?? "0", 10)} />
              <p>{triage.body}</p>
              {triage.sources && triage.output && (
                <FanIn sources={triage.sources} output={triage.output} label="Inputs to the triage toolset" />
              )}
            </div>
          )
        }
        {
          briefing && (
            <div class="ws__card ws__card--brief">
              <h4>{briefing.title}</h4>
              <p>{briefing.body}</p>
              {briefing.inputs && briefing.output && (
                <div class="ws__brief-visual">
                  <ul class="ws__brief-in" role="list" aria-label="Inputs">
                    {briefing.inputs.map((s) => (
                      <li class="chip">{s}</li>
                    ))}
                  </ul>
                  <span class="ws__brief-arrow" aria-hidden="true" />
                  <div class="ws__slides">
                    <span class="ws__slide-stack" aria-hidden="true">
                      <span class="ws__slide" />
                      <span class="ws__slide" />
                      <span class="ws__slide">
                        <i />
                        <i />
                        <b />
                      </span>
                    </span>
                    <span class="ws__slides-label">{briefing.output}</span>
                  </div>
                </div>
              )}
            </div>
          )
        }
      </div>

      <p class="ws__bridge">
        <span>{w.bridge}</span>
        <a class="text-link" href={w.bridgeLink.href}>{w.bridgeLink.label}<Arrow /></a>
      </p>
    </article>
  </div>
</section>

<style>
  .case {
    min-width: 0;
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3rem);
    padding-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    border-top: 1px solid var(--rule-strong);
  }

  .case + .case {
    margin-top: clamp(4.5rem, 3rem + 5vw, 7rem);
  }

  .case__head {
    display: grid;
    gap: var(--space-3);
  }

  .case__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.875rem;
  }

  .case__tag {
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    background: var(--forest-900);
    color: var(--paper);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .case__tag--live {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .case__tag--live::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lime-200);
  }

  .case__note {
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  .case h3 {
    font-size: var(--step-3);
  }

  .case__intro {
    max-width: 46rem;
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-muted);
  }

  .case__grid {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  .case__narrative {
    display: grid;
    gap: var(--space-6);
    align-content: start;
  }

  .case__block {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }

  .case__block p {
    max-width: 40rem;
    color: var(--ink-muted);
  }

  /* ----- result card ----- */

  .result {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    border-radius: var(--radius-l);
    background: var(--white);
    border: 1px solid var(--rule);
    box-shadow: var(--shadow-frame);
  }

  .result__title {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--olive-700);
  }

  .result__label {
    max-width: 22rem;
    font-weight: 500;
    line-height: 1.45;
  }

  .result__body {
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
    font-size: 0.9375rem;
    color: var(--ink-muted);
  }

  @media (min-width: 64rem) {
    .case__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }

  /* ----- output ----- */

  .case__output {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .case__output-copy {
    display: grid;
    gap: var(--space-3);
  }

  .case__output-copy p {
    max-width: 30rem;
    color: var(--ink-muted);
  }

  @media (min-width: 64rem) {
    .case__output {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: var(--space-8);
    }
  }

  /* ----- Wärtsilä ----- */

  .ws__grid {
    display: grid;
    gap: var(--space-5);
  }

  .ws__card {
    min-width: 0;
    display: grid;
    gap: var(--space-4);
    align-content: start;
    padding: clamp(1.4rem, 1rem + 1.6vw, 2rem);
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    background: var(--white);
  }

  .ws__card p {
    color: var(--ink-muted);
  }

  .ws__card .result__label {
    color: var(--ink);
  }

  .ws__card .stat {
    color: var(--forest-900);
  }

  .ws__copy {
    display: grid;
    gap: var(--space-3);
  }

  .ws__copy p {
    max-width: 48rem;
  }

  .ws__stat {
    display: grid;
    gap: var(--space-3);
  }

  .ws__card--brief {
    background: var(--moss-100);
    border-color: transparent;
    align-self: stretch;
    grid-template-rows: auto auto 1fr;
  }

  .ws__card--brief .ws__brief-visual {
    align-self: end;
  }

  .ws__brief-visual {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: var(--space-3);
  }

  .ws__brief-in {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  .ws__brief-in .chip {
    color: var(--ink);
  }

  .ws__slides {
    display: grid;
    justify-items: start;
    gap: 0.6rem;
  }

  .ws__slide-stack {
    position: relative;
    display: block;
    width: 7.5rem;
    height: 5.25rem;
  }

  .ws__slide {
    position: absolute;
    width: 6.5rem;
    aspect-ratio: 16 / 10;
    border-radius: 5px;
    background: var(--sage-300);
    box-shadow: 0 6px 14px -10px rgb(21 40 29 / 0.6);
  }

  .ws__slide:nth-child(1) {
    top: 0;
    left: 1rem;
    background: var(--sage-200);
  }

  .ws__slide:nth-child(2) {
    top: 0.5rem;
    left: 0.5rem;
  }

  .ws__slide:nth-child(3) {
    top: 1rem;
    left: 0;
    display: grid;
    align-content: start;
    gap: 0.3rem;
    padding: 0.55rem;
    background: var(--forest-900);
  }

  .ws__slide i {
    display: block;
    height: 0.35rem;
    border-radius: 2px;
    background: var(--lime-200);
  }

  .ws__slide i:nth-child(2) {
    width: 60%;
    background: var(--sage-300);
  }

  .ws__slide b {
    display: block;
    width: 1.6rem;
    height: 1rem;
    margin-top: 0.15rem;
    border-radius: 2px;
    background: var(--olive-400);
  }

  .ws__slides-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--forest-900);
  }

  .ws__brief-arrow {
    flex: 1;
    max-width: 4rem;
    height: 1px;
    background: var(--forest-700);
    position: relative;
  }

  .ws__brief-arrow::after {
    content: '';
    position: absolute;
    right: 0;
    top: -3px;
    width: 7px;
    height: 7px;
    border-top: 1px solid var(--forest-700);
    border-right: 1px solid var(--forest-700);
    transform: rotate(45deg);
  }

  @media (min-width: 64rem) {
    .ws__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .ws__card--wide {
      grid-column: 1 / -1;
    }
  }

  .ws__bridge {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3) var(--space-5);
    font-family: var(--font-serif);
    font-size: var(--step-2);
    line-height: 1.35;
    color: var(--ink);
  }

  .ws__bridge span {
    max-width: 44rem;
  }

  .ws__bridge .text-link {
    font-family: var(--font-sans);
    font-size: 1rem;
  }
</style>
