---
/**
 * Translation and bridging. On the left, a loose network of nodes: the
 * complex system. On the right, ordered bars: the workflow people use. Strands
 * leave the network tangled, pass through a translation layer and arrive in
 * order. On load the strands draw and the bars fill; as the hero scrolls away,
 * the loose nodes settle into the same rows as the workflow.
 *
 * Entirely decorative: aria-hidden, no pointer events.
 */
interface Props {
  /** "hero" animates on load and organises on scroll. "settled" is static and fully connected. */
  mode?: 'hero' | 'settled';
  labels?: { from: string; to: string };
}
const { mode = 'hero', labels } = Astro.props;

const ROWS = [120, 168, 216, 264, 312, 360];
const GATE_X = 300;
const BAR_X = 386;

// Six interface nodes on the network's edge, deliberately out of order.
const exits = [
  { x: 228, y: 312 },
  { x: 216, y: 168 },
  { x: 234, y: 360 },
  { x: 222, y: 120 },
  { x: 238, y: 264 },
  { x: 212, y: 216 },
];
// exits[k] feeds the bar in row barFor[k].
const barFor = [1, 3, 2, 4, 0, 5];

type Kind = 'dot' | 'ring' | 'square';
const loose: { x: number; y: number; r: number; kind: Kind; tone: string }[] = [
  { x: 58, y: 96, r: 6, kind: 'dot', tone: 'var(--olive-400)' },
  { x: 112, y: 78, r: 4, kind: 'dot', tone: 'var(--olive-600)' },
  { x: 165, y: 104, r: 7, kind: 'square', tone: 'var(--sage-300)' },
  { x: 190, y: 146, r: 4, kind: 'dot', tone: 'var(--forest-700)' },
  { x: 74, y: 148, r: 6, kind: 'ring', tone: 'var(--olive-600)' },
  { x: 132, y: 136, r: 9, kind: 'dot', tone: 'var(--sage-300)' },
  { x: 40, y: 206, r: 4, kind: 'dot', tone: 'var(--olive-600)' },
  { x: 96, y: 196, r: 7, kind: 'square', tone: 'var(--olive-400)' },
  { x: 160, y: 190, r: 5, kind: 'dot', tone: 'var(--olive-400)' },
  { x: 178, y: 246, r: 6, kind: 'ring', tone: 'var(--forest-700)' },
  { x: 60, y: 262, r: 8, kind: 'dot', tone: 'var(--sage-300)' },
  { x: 118, y: 250, r: 4, kind: 'dot', tone: 'var(--forest-700)' },
  { x: 146, y: 302, r: 7, kind: 'square', tone: 'var(--olive-400)' },
  { x: 84, y: 322, r: 5, kind: 'dot', tone: 'var(--olive-600)' },
  { x: 40, y: 352, r: 6, kind: 'ring', tone: 'var(--olive-400)' },
  { x: 122, y: 372, r: 9, kind: 'dot', tone: 'var(--sage-300)' },
  { x: 176, y: 352, r: 4, kind: 'dot', tone: 'var(--olive-600)' },
  { x: 88, y: 408, r: 5, kind: 'dot', tone: 'var(--olive-400)' },
];

// Where each loose node settles: three columns, aligned to the workflow rows.
// Sorting by y then x keeps paths short and uncrossed.
const COLS = [64, 112, 160];
const order = loose
  .map((n, i) => ({ ...n, i }))
  .sort((a, b) => a.y - b.y);
const targets = new Map<number, { x: number; y: number }>();
for (let row = 0; row < ROWS.length; row++) {
  const chunk = order.slice(row * 3, row * 3 + 3).sort((a, b) => a.x - b.x);
  chunk.forEach((n, col) => targets.set(n.i, { x: COLS[col]!, y: ROWS[row]! }));
}

// Deterministic scatter for the entrance, so builds are reproducible.
const jitter = (i: number, salt: number) => Math.round(Math.sin(i * 12.9898 + salt * 78.233) * 43758.5453) % 28;

// Mesh: each node joined to its two nearest neighbours.
const all = [...loose.map((n) => ({ x: n.x, y: n.y })), ...exits];
const edges = new Set<string>();
all.forEach((a, i) => {
  all
    .map((b, j) => ({ j, d: (a.x - b.x) ** 2 + (a.y - b.y) ** 2 }))
    .filter((o) => o.j !== i)
    .sort((p, q) => p.d - q.d)
    .slice(0, 2)
    .forEach(({ j }) => edges.add(i < j ? `${i}-${j}` : `${j}-${i}`));
});
const mesh = [...edges].map((key) => key.split('-').map(Number) as [number, number]);

const strands = exits.map((e, k) => {
  const y = ROWS[barFor[k]!]!;
  return `M${e.x} ${e.y} C${e.x + 44} ${e.y} ${GATE_X - 46} ${y} ${GATE_X} ${y} S${BAR_X - 26} ${y} ${BAR_X - 8} ${y}`;
});

const barWidths = [168, 132, 186, 150, 120, 160];
const barFill = [0.82, 0.6, 0.9, 0.7, 0.52, 0.76];
---

<div class:list={['bridge', `bridge--${mode}`, 'shape']} data-scrub={mode === 'hero' ? 'exit' : undefined}>
  <svg viewBox="0 0 600 470" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid meet">
    <!-- Row guides appear as the network organises. -->
    <g class="bridge__guides">
      {ROWS.map((y) => <line x1="40" y1={y} x2="560" y2={y} />)}
    </g>

    <g class="bridge__mesh">
      {mesh.map(([a, b]) => <line x1={all[a]!.x} y1={all[a]!.y} x2={all[b]!.x} y2={all[b]!.y} />)}
    </g>

    <g class="bridge__loose">
      {
        loose.map((n, i) => {
          const t = targets.get(i)!;
          return (
            <g class="bridge__settle" style={`--tx:${t.x - n.x}px;--ty:${t.y - n.y}px`}>
              <g
                class="bridge__node"
                style={`--i:${i};--ox:${jitter(i, 1)}px;--oy:${jitter(i, 2)}px`}
              >
                {n.kind === 'dot' && <circle cx={n.x} cy={n.y} r={n.r} fill={n.tone} />}
                {n.kind === 'ring' && (
                  <circle cx={n.x} cy={n.y} r={n.r} fill="none" stroke={n.tone} stroke-width="1.5" />
                )}
                {n.kind === 'square' && (
                  <rect x={n.x - n.r} y={n.y - n.r} width={n.r * 2} height={n.r * 2} rx="2.5" fill={n.tone} />
                )}
              </g>
            </g>
          );
        })
      }
    </g>

    <g class="bridge__strands">
      {strands.map((d, k) => <path d={d} pathLength="1" style={`--i:${k}`} />)}
    </g>

    <g class="bridge__exits">
      {
        exits.map((e, k) => (
          <g class="bridge__node" style={`--i:${k + loose.length};--ox:-14px;--oy:0px`}>
            <circle cx={e.x} cy={e.y} r="9" class="bridge__halo" />
            <circle cx={e.x} cy={e.y} r="4.5" class="bridge__exit" />
          </g>
        ))
      }
    </g>

    <!-- The translation layer. -->
    <g class="bridge__gate">
      <rect x={GATE_X - 13} y="88" width="26" height="304" rx="13" class="bridge__gate-body" />
      {ROWS.map((y) => <line x1={GATE_X - 6} y1={y} x2={GATE_X + 6} y2={y} class="bridge__gate-tick" />)}
    </g>

    <g class="bridge__bars">
      {
        ROWS.map((y, i) => (
          <g class="bridge__bar" style={`--i:${i}`}>
            <rect x={BAR_X + 14} y={y - 9} width={barWidths[i]} height="18" rx="9" class="bridge__track" />
            <rect
              x={BAR_X + 14}
              y={y - 9}
              width={Math.round(barWidths[i]! * barFill[i]!)}
              height="18"
              rx="9"
              class="bridge__fill"
            />
            <circle cx={BAR_X} cy={y} r="5.5" class="bridge__dot" />
          </g>
        ))
      }
    </g>
  </svg>
  {
    labels && (
      <div class="bridge__labels" aria-hidden="true">
        <span>{labels.from}</span>
        <span>{labels.to}</span>
      </div>
    )
  }
</div>

<style>
  .bridge {
    --p: 0;
    position: relative;
    width: 100%;
  }

  .bridge--settled {
    --p: 1;
  }

  .bridge svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .bridge__labels {
    display: flex;
    justify-content: space-between;
    padding-inline: 4%;
    margin-top: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* ----- static styling ----- */

  .bridge__guides line {
    stroke: var(--sage-200);
    stroke-width: 1;
    stroke-dasharray: 2 6;
    opacity: calc(var(--p) * 0.9);
  }

  .bridge__mesh line {
    stroke: var(--sage-300);
    stroke-width: 1;
    opacity: calc(0.75 * (1 - var(--p)));
  }

  .bridge__strands path {
    fill: none;
    stroke: var(--forest-700);
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .bridge__halo {
    fill: var(--paper);
    stroke: var(--sage-300);
    stroke-width: 1;
  }

  .bridge__exit {
    fill: var(--forest-900);
  }

  .bridge__gate-body {
    fill: var(--moss-100);
    stroke: var(--rule-strong);
    stroke-width: 1;
  }

  .bridge__gate-tick {
    stroke: var(--forest-700);
    stroke-width: 1.4;
    stroke-linecap: round;
  }

  .bridge__track {
    fill: var(--paper-3);
  }

  .bridge__fill {
    fill: var(--forest-900);
    transform-box: fill-box;
    transform-origin: left center;
  }

  .bridge__bar:nth-child(even) .bridge__fill {
    fill: var(--forest-700);
  }

  .bridge__dot {
    fill: var(--paper);
    stroke: var(--forest-900);
    stroke-width: 1.6;
  }

  .bridge__gate {
    transform-box: fill-box;
    transform-origin: center;
  }

  .bridge__node {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Scroll: the loose network settles into the workflow rows. */
  .bridge__settle {
    transform: translate(calc(var(--tx) * var(--p)), calc(var(--ty) * var(--p)));
  }

  /* ----- entrance (hero only; removed entirely under reduced motion) ----- */

  @media (prefers-reduced-motion: no-preference) {
    .bridge--hero .bridge__node {
      animation: bridge-node 1.8s var(--ease-out) both;
      animation-delay: calc(var(--i) * 40ms);
    }

    .bridge--hero .bridge__mesh {
      animation: bridge-fade 1.6s ease 0.5s both;
    }

    .bridge--hero .bridge__gate {
      animation: bridge-gate 1.4s var(--ease-out) 0.6s both;
    }

    .bridge--hero .bridge__strands path {
      animation: bridge-draw 1.9s var(--ease-in-out) both;
      animation-delay: calc(1s + var(--i) * 0.13s);
    }

    .bridge--hero .bridge__dot {
      animation: bridge-fade 0.6s ease both;
      animation-delay: calc(2.2s + var(--i) * 0.13s);
    }

    .bridge--hero .bridge__fill {
      animation: bridge-grow 1.2s var(--ease-out) both;
      animation-delay: calc(2.4s + var(--i) * 0.13s);
    }

    .bridge--hero .bridge__track {
      animation: bridge-fade 1s ease 1.8s both;
    }
  }

  @keyframes bridge-node {
    from {
      opacity: 0;
      transform: translate(var(--ox), var(--oy)) scale(0.4);
    }
  }

  @keyframes bridge-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes bridge-gate {
    from {
      opacity: 0;
      transform: scaleY(0.3);
    }
  }

  @keyframes bridge-draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  @keyframes bridge-grow {
    from {
      transform: scaleX(0);
    }
  }
</style>
