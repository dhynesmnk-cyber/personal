---
/**
 * Many inputs, one prioritised output. Inputs are a real list; the converging
 * lines are decoration.
 */
interface Props {
  sources: string[];
  output: string;
  label: string;
}
const { sources, output, label } = Astro.props;
const n = sources.length;
const paths = sources.map((_, i) => {
  const y = ((i + 0.5) / n) * 100;
  return `M0 ${y} C 55 ${y}, 45 50, 100 50`;
});
---

<div class="fan" data-reveal>
  <ul class="fan__in" role="list" aria-label={label}>
    {sources.map((s) => <li class="chip">{s}</li>)}
  </ul>
  <div class="fan__mid">
    <svg class="fan__lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      {paths.map((d, i) => <path d={d} style={`--i:${i}`} />)}
    </svg>
  </div>
  <p class="fan__out">{output}</p>
</div>

<style>
  .fan {
    display: grid;
    grid-template-columns: minmax(0, max-content) minmax(1.5rem, 10rem) minmax(0, 8.5rem);
    align-items: stretch;
    gap: 0;
  }

  .fan__in {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  .fan__in .chip {
    justify-content: flex-start;
    color: var(--ink);
    white-space: normal;
  }

  .fan__mid {
    position: relative;
    min-width: 1.5rem;
  }

  .fan__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .fan__lines path {
    fill: none;
    stroke: var(--forest-700);
    stroke-width: 1.3;
    vector-effect: non-scaling-stroke;
    transition: opacity 0.7s ease calc(var(--i) * 120ms);
  }

  .fan__out {
    align-self: center;
    padding: 0.75rem 0.9rem;
    border-radius: var(--radius-m);
    background: var(--forest-900);
    color: var(--paper);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.3;
  }

  :global(.has-motion) .fan:not(:global(.is-in)) .fan__lines path {
    opacity: 0;
  }
</style>
