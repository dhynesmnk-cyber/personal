---
/**
 * Before and after, as two bars indexed to the starting point. Mirrors a
 * figure already stated in the text, so it is hidden from assistive tech.
 */
interface Props {
  reduction: number;
  before?: string;
  after?: string;
}
const { reduction, before = 'Before', after = 'After' } = Astro.props;
---

<div class="rb" data-reveal aria-hidden="true" style={`--after:${(100 - reduction) / 100}`}>
  <span class="rb__label">{before}</span>
  <span class="rb__track"><span class="rb__bar rb__bar--before"></span></span>
  <span class="rb__label">{after}</span>
  <span class="rb__track"><span class="rb__bar rb__bar--after"></span></span>
</div>

<style>
  .rb {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.5rem 0.875rem;
    max-width: 22rem;
  }

  .rb__label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .rb__track {
    display: block;
    height: 0.625rem;
    border-radius: 999px;
    background: var(--paper-3);
    overflow: hidden;
  }

  .rb__bar {
    display: block;
    height: 100%;
    border-radius: inherit;
    transform-origin: left;
    transition: transform 1.1s var(--ease-out) 0.2s;
  }

  .rb__bar--before {
    background: var(--sage-300);
  }

  .rb__bar--after {
    background: var(--forest-900);
    transform: scaleX(var(--after));
    transition-delay: 0.6s;
  }

  :global(.has-motion) .rb:not(:global(.is-in)) .rb__bar--after {
    transform: scaleX(1);
  }

  :global(.has-motion) .rb:not(:global(.is-in)) .rb__bar--before {
    transform: scaleX(0);
  }
</style>
