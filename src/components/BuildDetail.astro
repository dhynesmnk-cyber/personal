---
import { Picture } from 'astro:assets';
import type { Build } from '../content/work';
import Arrow from './Arrow.astro';
import GatePipeline from './shapes/GatePipeline.astro';
import observatory from '../assets/work/observatory.png';
import coldpath from '../assets/work/coldpath.png';
import bee from '../assets/work/bee.png';

/** The body of one of our own builds. The page hero carries the h1. */
interface Props {
  build: Build;
}
const { build: p } = Astro.props;
const images = { observatory, coldpath, bee };
---

<div class="project">
  <figure class="frame">
    <div class="frame__plate">
      <div class="frame__window">
        <div class="frame__bar" aria-hidden="true">
          <span />
          <span />
          <span />
        </div>
        <Picture
          src={images[p.image.key]}
          alt={p.image.alt}
          formats={['avif', 'webp']}
          widths={[560, 840, 1120, 1440]}
          sizes="(min-width: 64rem) 640px, 100vw"
          quality={78}
          fallbackFormat="webp"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
    <figcaption>{p.image.caption}</figcaption>
  </figure>

  <div class="project__copy">
    <div class="project__summary">
      {p.body.map((s) => <p>{s}</p>)}
    </div>

    <h2 class="project__gov-title">{p.governanceTitle}</h2>
    <ul class="project__gov" role="list">
      {p.governance.map((g) => <li>{g}</li>)}
    </ul>

    <div class="project__pipe">
      <p class="project__pipe-label">{p.pipelineLabel}</p>
      <GatePipeline steps={p.pipeline} label={`${p.pipelineLabel}, in order`} />
    </div>

    <div class="project__foot">
      <ul class="project__stack" role="list" aria-label="Built with">
        {p.stack.map((s) => <li>{s}</li>)}
      </ul>
      <a class="text-link" href={p.link.href}>
        {p.link.label}
        <Arrow direction="up-right" />
      </a>
    </div>
  </div>
</div>

<style>
  .project {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .project {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .frame {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  /* ----- screenshot frame ----- */

  .frame {
    position: relative;
    margin: 0;
  }

  .frame__plate {
    position: relative;
    padding: 0 1rem 1rem 0;
  }

  /* A layered backing plate that shifts on hover. */
  .frame__plate::before {
    content: '';
    position: absolute;
    inset: 1rem 0 0 1rem;
    border-radius: var(--radius-l);
    background: var(--sage-200);
    transition: transform 0.6s var(--ease-out);
  }

  .frame__window {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-l);
    background: var(--forest-950);
    box-shadow: var(--shadow-frame);
    transition: transform 0.6s var(--ease-out);
  }

  .project:hover .frame__window {
    transform: translate(-4px, -4px);
  }

  .project:hover .frame__plate::before {
    transform: translate(4px, 4px);
  }

  .frame__bar {
    display: flex;
    gap: 6px;
    padding: 0.6rem 0.8rem;
    background: var(--forest-900);
  }

  .frame__bar span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.22);
  }

  .frame :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top left;
  }

  .frame figcaption {
    margin-top: 0.75rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  /* ----- copy ----- */

  .project__copy {
    display: grid;
    gap: var(--space-4);
  }

  .project__summary {
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .project__summary {
    display: grid;
    gap: var(--space-3);
    color: var(--ink-muted);
  }

  .project__gov-title {
    margin-top: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--olive-700);
  }

  .project__gov {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: 1px solid var(--rule);
  }

  .project__gov li {
    position: relative;
    padding: 0.6rem 0 0.6rem 1.6rem;
    border-bottom: 1px solid var(--rule);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  /* Gate glyph bullet. */
  .project__gov li::before,
  .project__gov li::after {
    content: '';
    position: absolute;
    top: 0.95rem;
    width: 2px;
    height: 0.7rem;
    border-radius: 1px;
    background: var(--olive-600);
  }

  .project__gov li::before {
    left: 0.15rem;
  }

  .project__gov li::after {
    left: 0.55rem;
  }

  .project__pipe {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .project__pipe-label {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--olive-700);
  }

  .project__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--rule);
  }

  .project__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
  }

  .project__stack li {
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-s);
    background: var(--paper-2);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink);
  }
</style>
